# Server Port
PORT=5000

# Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/startup2gov?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/startup2gov?retryWrites=true&w=majority

# JWT Authentication
# Set JWT_SECRET to at least 32 random bytes; no default secret is provided.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# No refresh-token flow is currently implemented.

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# Demo Seed Config (non-production only; set true only when demo users are needed)
SEED_DEMO_USERS=false
